# ---- infra (docker-compose) ----
DATABASE_URL=postgres://bookrunner:bookrunner@127.0.0.1:54400/bookrunner
REDIS_URL=redis://127.0.0.1:63790

# ---- chain ----
# Local devnet (anvil). Robinhood Chain mainnet is 4663 (VERIFY RPC; spec uses Dwellir archive RPC).
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8547
# Written by `bun run deploy:local` (forge script Deploy.s.sol + LaunchBooks.s.sol)
DEPLOYMENT_FILE=contracts/deployments/31337.json

# Dev keys are derived from the anvil test mnemonic by role index (packages/shared/src/devkeys.ts).
# On any non-local chain every *_PRIVATE_KEY must be set explicitly (never the test mnemonic).
DEV_MNEMONIC=test test test test test test test test test test test junk
# MARK_SIGNER_PRIVATE_KEY=
# RISK_PRIVATE_KEY=
# OPS_VENUE_PRIVATE_KEY=
# JURY_PRIVATE_KEY=
# KEEPER_PRIVATE_KEY=
# ORACLE_SIGNER_PRIVATE_KEY=

# ---- services ----
API_PORT=4400
WEB_PORT=5180
ORACLE_PORT=4410
MOCK_ORDERLY_PORT=4420
# Mark cadence. Mainnet: 86400 (daily). Devnet default: 300 (5 min) so marks are visible quickly.
MARK_INTERVAL_SECONDS=300
# Receipts root cadence. Mainnet: 3600 (hourly). Devnet: 60.
RECEIPTS_INTERVAL_SECONDS=60
# Session override for demos outside market hours: "charter" (respect charter sessions) | "24x7"
SESSIONS_MODE=24x7

# ---- venue: Orderly Perp Anything (VERIFY every endpoint/id before mainnet) ----
# "mock" uses services/mock-orderly; "live" uses the real Orderly REST API.
ORDERLY_MODE=mock
ORDERLY_BASE_URL=http://127.0.0.1:4420
# ORDERLY_BROKER_ID=
# ORDERLY_BUILDER_ACCOUNT_ID=
# ORDERLY_KEY=           # ed25519 trade-only key (per book account); never the asset/withdraw key
# ORDERLY_SECRET=
# live mainnet (docs/VERIFY.md section 1): ORDERLY_BASE_URL=https://api.orderly.org, testnet https://testnet-api.orderly.org
# ORDERLY_TOKEN=USDC             # settlement token symbol on Orderly; USDG on Robinhood Chain
# ORDERLY_LEDGER_ADDRESS=        # Withdraw EIP-712 verifyingContract (default mainnet Ledger; testnet 0x1826B75e2ef249173FC735149AE4B8e9ea10abff)
# ORDERLY_EIP712_CHAIN_ID=       # chainId in Orderly messages (default CHAIN_ID; RHC mainnet 4663)
# OPS_NATIVE_TOPUP_MAX_WEI=0     # >0: ops-venue tops Orderly adapters up for the native deposit fee (adapter.fundNative)
# contracts deploy (scripts/forge.sh passes these through): DEPLOY_ORDERLY_BROKER_ID=bookrunner DEPLOY_ORDERLY_TOKEN=USDC

# ---- model jury (optional) ----
# If set, the charter service runs the model jury with Claude; otherwise a deterministic rule-based jury.
# ANTHROPIC_API_KEY=
JURY_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-4-5-20251001

# ---- webhooks ----
WEBHOOK_SIGNING_SECRET=dev-webhook-secret
