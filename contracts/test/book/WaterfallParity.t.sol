pragma solidity 0.8.30;

import {Test} from "forge-std/Test.sol";
import {Waterfall} from "../../src/libraries/Waterfall.sol";

/// @notice Parity with the NORMATIVE TypeScript waterfall (packages/shared/src/waterfall.ts).
///         Vectors: test/vectors/waterfall.json generated by scripts/gen-vectors.ts. Row formats:
///   window: [ifTarget, mmInventory, seniorCapBps, seniorCommitted, juniorCommitted, sponsorJuniorCommitted,
///            ok(0|1), reason(0 ok|1 NO_JUNIOR|2 SPONSOR_SKIN|3 IF_UNFUNDED), seniorAllocated, juniorAllocated,
///            sponsorJuniorAllocated]
///   split:  [gross, expensesRequested, expenseCapBps, carryBps, seniorHurdleBps, seniorSupply, juniorSupply,
///            expenses, carry, senior, junior]
///   mark:   [S, J, seniorImpairment, perfIndex, highWater, nav, juniorSupply, backstopAvailable,
///            S', J', seniorImpairment', perfIndex', highWater', backstopCovered, |drawdownBps|,
///            backstopDebt, backstopRepaid, backstopDebt']
///   wallet: [commit, isSponsor(0|1), totalCommitted, sponsorCommitted, totalAllocated, shares, refund]
///   credit: [senior, junior, juniorSupply, seniorImpairment, backstopDebt, seniorCredit, juniorCredit,
///            seniorRestored, backstopRepaid, seniorImpairment', backstopDebt'] (audit L-1)
///   insurance pool (2026-10): premium [gross, charterPremiumBps, floorBps, expensesRequested, expenseCapBps, carryBps,
///            seniorHurdleBps, seniorSupply, juniorSupply, effectivePremiumBps, premium, expenses, carry, senior, junior];
///            poolCredit and poolMark (the explicit insurance ledger, pool audit 2026-10-23; formats in
///            scripts/gen-vectors.ts); poolWindow [ifTarget, mm, seniorCapBps, seniorCommitted, juniorCommitted,
///            sponsorJuniorCommitted, ok, reason, seniorAllocated, juniorAllocated, ifRaised, mmAmount, idle,
///            minOwnCapitalBps, capitalOk]. poolBook rows: test/pool/PoolBookParity.t.sol.
contract WaterfallParityTest is Test {
    string internal json;
    uint256 internal count;

    function setUp() public {
        json = vm.readFile("test/vectors/waterfall.json");
        count = vm.parseJsonUint(json, ".count");
    }

    function _row(string memory section, uint256 i) internal view returns (uint256[] memory) {
        return vm.parseJsonUintArray(json, string.concat(".", section, "[", vm.toString(i), "]"));
    }

    function test_vectorCount() public view {
        assertEq(count, 256, "vector count");
    }

    function test_parity_window() public view {
        for (uint256 i = 0; i < count; i++) {
            uint256[] memory v = _row("window", i);
            assertEq(v.length, 11, "window row width");
            Waterfall.WindowResult memory r = Waterfall.allocateWindow(
                Waterfall.WindowInput({
                    ifTargetUsd: v[0],
                    mmInventoryUsd: v[1],
                    seniorCapBps: v[2],
                    seniorCommitted: v[3],
                    juniorCommitted: v[4],
                    sponsorJuniorCommitted: v[5]
                })
            );
            string memory tag = string.concat("window[", vm.toString(i), "]");
            assertEq(r.ok ? 1 : 0, v[6], string.concat(tag, " ok"));
            assertEq(uint256(r.reason), v[7], string.concat(tag, " reason"));
            assertEq(r.seniorAllocated, v[8], string.concat(tag, " seniorAllocated"));
            assertEq(r.juniorAllocated, v[9], string.concat(tag, " juniorAllocated"));
            assertEq(r.sponsorJuniorAllocated, v[10], string.concat(tag, " sponsorJuniorAllocated"));
            // sponsor priority: whenever the window succeeds the sponsor holds >= 10% of allocated Junior
            if (r.ok) {
                assertGe(
                    r.sponsorJuniorAllocated * Waterfall.BPS,
                    r.juniorAllocated * Waterfall.SPONSOR_MIN_JUNIOR_BPS,
                    string.concat(tag, " sponsor skin")
                );
            }
        }
    }

    function test_parity_split() public view {
        for (uint256 i = 0; i < count; i++) {
            uint256[] memory v = _row("split", i);
            assertEq(v.length, 11, "split row width");
            Waterfall.SplitResult memory o = Waterfall.splitDistribution(
                Waterfall.SplitInput({
                    gross: v[0],
                    expensesRequested: v[1],
                    expenseCapBps: v[2],
                    carryBps: v[3],
                    seniorHurdleBps: v[4],
                    seniorSupply: v[5],
                    juniorSupply: v[6]
                })
            );
            string memory tag = string.concat("split[", vm.toString(i), "]");
            assertEq(o.gross, v[0], string.concat(tag, " gross"));
            assertEq(o.expenses, v[7], string.concat(tag, " expenses"));
            assertEq(o.carry, v[8], string.concat(tag, " carry"));
            assertEq(o.senior, v[9], string.concat(tag, " senior"));
            assertEq(o.junior, v[10], string.concat(tag, " junior"));
        }
    }

    function test_parity_mark() public view {
        for (uint256 i = 0; i < count; i++) {
            uint256[] memory v = _row("mark", i);
            assertEq(v.length, 18, "mark row width");
            Waterfall.MarkResult memory r = Waterfall.applyMarkPnl(
                Waterfall.MarkState({
                    seniorNav: v[0],
                    juniorNav: v[1],
                    seniorImpairment: v[2],
                    perfIndex: v[3],
                    highWater: v[4],
                    backstopDebt: v[15]
                }),
                Waterfall.MarkInputs({nav: v[5], juniorSupply: v[6], backstopAvailable: v[7]})
            );
            string memory tag = string.concat("mark[", vm.toString(i), "]");
            assertEq(r.seniorNav, v[8], string.concat(tag, " S'"));
            assertEq(r.juniorNav, v[9], string.concat(tag, " J'"));
            assertEq(r.seniorImpairment, v[10], string.concat(tag, " impairment'"));
            assertEq(r.perfIndex, v[11], string.concat(tag, " perfIndex'"));
            assertEq(r.highWater, v[12], string.concat(tag, " highWater'"));
            assertEq(r.backstopCovered, v[13], string.concat(tag, " backstopCovered"));
            assertLe(r.drawdownBps, int256(0), string.concat(tag, " drawdown sign"));
            assertEq(uint256(-r.drawdownBps), v[14], string.concat(tag, " |drawdownBps|"));
            assertEq(r.backstopRepaid, v[16], string.concat(tag, " backstopRepaid"));
            assertEq(r.backstopDebt, v[17], string.concat(tag, " backstopDebt'"));
            // conservation: S' + J' == nav + backstopCovered - backstopRepaid
            assertEq(
                r.seniorNav + r.juniorNav,
                v[5] + r.backstopCovered - r.backstopRepaid,
                string.concat(tag, " conservation")
            );
            assertEq(r.pnl, int256(v[5]) - int256(v[0] + v[1]), string.concat(tag, " pnl"));
        }
    }

    function test_parity_wallet() public view {
        for (uint256 i = 0; i < count; i++) {
            uint256[] memory v = _row("wallet", i);
            assertEq(v.length, 7, "wallet row width");
            (uint256 shares, uint256 refund) = Waterfall.juniorWindowAllocation(v[0], v[1] == 1, v[2], v[3], v[4]);
            string memory tag = string.concat("wallet[", vm.toString(i), "]");
            assertEq(shares, v[5], string.concat(tag, " shares"));
            assertEq(refund, v[6], string.concat(tag, " refund"));
            assertLe(shares + refund, v[0], string.concat(tag, " never over-pays"));
        }
    }

    function test_parity_credit() public view {
        for (uint256 i = 0; i < count; i++) {
            uint256[] memory v = _row("credit", i);
            assertEq(v.length, 11, "credit row width");
            Waterfall.DistributionResult memory r = Waterfall.applyDistribution(
                Waterfall.DistributionInput({
                    senior: v[0], junior: v[1], juniorSupply: v[2], seniorImpairment: v[3], backstopDebt: v[4]
                })
            );
            string memory tag = string.concat("credit[", vm.toString(i), "]");
            assertEq(r.seniorCredit, v[5], string.concat(tag, " seniorCredit"));
            assertEq(r.juniorCredit, v[6], string.concat(tag, " juniorCredit"));
            assertEq(r.seniorRestored, v[7], string.concat(tag, " seniorRestored"));
            assertEq(r.backstopRepaid, v[8], string.concat(tag, " backstopRepaid"));
            assertEq(r.seniorImpairment, v[9], string.concat(tag, " seniorImpairment'"));
            assertEq(r.backstopDebt, v[10], string.concat(tag, " backstopDebt'"));
            assertEq(
                r.seniorCredit + r.juniorCredit + r.backstopRepaid, v[0] + v[1], string.concat(tag, " conservation")
            );
        }
    }

    // ---- insurance pool (2026-10) ----

    function test_parity_premium() public view {
        for (uint256 i = 0; i < count; i++) {
            uint256[] memory v = _row("premium", i);
            assertEq(v.length, 15, "premium row width");
            string memory tag = string.concat("premium[", vm.toString(i), "]");
            uint256 bps = Waterfall.effectivePremiumBps(v[1], v[2]);
            assertEq(bps, v[9], string.concat(tag, " effectivePremiumBps"));
            (uint256 premium, uint256 rest) = Waterfall.premiumSplit(v[0], bps);
            assertEq(premium, v[10], string.concat(tag, " premium"));
            Waterfall.SplitResult memory o = Waterfall.splitDistribution(
                Waterfall.SplitInput({
                    gross: rest,
                    expensesRequested: v[3],
                    expenseCapBps: v[4],
                    carryBps: v[5],
                    seniorHurdleBps: v[6],
                    seniorSupply: v[7],
                    juniorSupply: v[8]
                })
            );
            assertEq(o.expenses, v[11], string.concat(tag, " expenses"));
            assertEq(o.carry, v[12], string.concat(tag, " carry"));
            assertEq(o.senior, v[13], string.concat(tag, " senior"));
            assertEq(o.junior, v[14], string.concat(tag, " junior"));
            assertEq(premium + o.expenses + o.carry + o.senior + o.junior, v[0], string.concat(tag, " conservation"));
        }
    }

    /// @notice Pool audit 2026-10-23 B-L2: a pool-funded book's fee credit on the ledger (an exhausted book's fee flow
    ///         restores the pool's claim first, then the mark gain order).
    function test_parity_poolCredit() public view {
        for (uint256 i = 0; i < count; i++) {
            uint256[] memory v = _row("poolCredit", i);
            assertEq(v.length, 23, "poolCredit row width");
            string memory tag = string.concat("poolCredit[", vm.toString(i), "]");
            Waterfall.PoolDistributionResult memory r = Waterfall.applyPoolDistribution(
                Waterfall.PoolDistributionInput({
                    senior: v[0],
                    junior: v[1],
                    juniorSupply: v[2],
                    seniorNav: v[19],
                    seniorImpairment: v[3],
                    seniorIfImpairment: v[4],
                    seniorIfDeferred: v[20],
                    juniorIfLoss: v[17],
                    backstopDebt: v[5],
                    coverHeld: v[6],
                    poolShortfall: v[7]
                })
            );
            assertEq(r.seniorCredit, v[8], string.concat(tag, " seniorCredit"));
            assertEq(r.juniorCredit, v[9], string.concat(tag, " juniorCredit"));
            assertEq(r.poolRestored, v[10], string.concat(tag, " poolRestored"));
            assertEq(r.seniorRestored, v[11], string.concat(tag, " seniorRestored"));
            assertEq(r.backstopRepaid, v[12], string.concat(tag, " backstopRepaid"));
            assertEq(r.seniorImpairment, v[13], string.concat(tag, " imp'"));
            assertEq(r.seniorIfImpairment, v[14], string.concat(tag, " impIf'"));
            assertEq(r.backstopDebt, v[15], string.concat(tag, " backstopDebt'"));
            assertEq(r.coverHeld, v[16], string.concat(tag, " coverHeld'"));
            assertEq(r.juniorIfLoss, v[18], string.concat(tag, " juniorIfLoss'"));
            assertEq(r.seniorIfCharged, v[21], string.concat(tag, " seniorIfCharged"));
            assertEq(r.seniorIfDeferred, v[22], string.concat(tag, " seniorIfDeferred'"));
            assertEq(
                r.seniorCredit + r.juniorCredit + r.poolRestored + r.backstopRepaid,
                v[0] + v[1],
                string.concat(tag, " conservation")
            );
        }
    }

    /// @notice Pool audit 2026-10-23 (owner ruling N-1, cumulative): a pool-funded book's mark on the explicit insurance
    ///         ledger, exactly as BookLogic._applyPoolPnl runs it.
    function test_parity_poolMark() public view {
        for (uint256 i = 0; i < count; i++) {
            uint256[] memory v = _row("poolMark", i);
            assertEq(v.length, 41, "poolMark row width");
            _poolMarkRow(v, string.concat("poolMark[", vm.toString(i), "]"));
        }
    }

    function _poolMarkRow(uint256[] memory v, string memory tag) internal pure {
        Waterfall.PoolMarkResult memory r = Waterfall.applyPoolMarkPnl(
            Waterfall.PoolMarkState({
                seniorNav: v[0],
                juniorNav: v[1],
                seniorImpairment: v[2],
                seniorIfImpairment: v[3],
                juniorIfLoss: v[4],
                coverHeld: v[5],
                backstopDebt: v[6],
                perfIndex: v[7],
                highWater: v[8],
                poolValue: v[9],
                poolDebt: v[10],
                ifDraw: v[11],
                seniorIfDeferred: v[38]
            }),
            Waterfall.PoolMarkInputs({netAssets: v[12], ifDraw: v[13], juniorSupply: v[14], backstopAvailable: v[15]})
        );
        Waterfall.PoolMarkState memory s = r.s;
        assertEq(s.seniorNav, v[16], string.concat(tag, " S'"));
        assertEq(s.juniorNav, v[17], string.concat(tag, " J'"));
        assertEq(s.seniorImpairment, v[18], string.concat(tag, " imp'"));
        assertEq(s.seniorIfImpairment, v[19], string.concat(tag, " impIf'"));
        assertEq(s.juniorIfLoss, v[20], string.concat(tag, " juniorIfLoss'"));
        assertEq(s.coverHeld, v[21], string.concat(tag, " coverHeld'"));
        assertEq(s.backstopDebt, v[22], string.concat(tag, " backstopDebt'"));
        assertEq(s.perfIndex, v[23], string.concat(tag, " perfIndex'"));
        assertEq(s.highWater, v[24], string.concat(tag, " highWater'"));
        assertEq(s.poolValue, v[25], string.concat(tag, " poolValue'"));
        assertEq(s.ifDraw, v[26], string.concat(tag, " ifDraw'"));
        assertEq(r.nav, v[27], string.concat(tag, " nav"));
        assertEq(uint256(-r.drawdownBps), v[28], string.concat(tag, " |drawdownBps|"));
        assertEq(r.juniorLoss, v[29], string.concat(tag, " juniorLoss"));
        assertEq(r.seniorLoss, v[30], string.concat(tag, " seniorLoss"));
        assertEq(r.seniorIfLoss, v[31], string.concat(tag, " seniorIfLoss"));
        assertEq(r.poolLoss, v[32], string.concat(tag, " poolLoss"));
        assertEq(r.poolRestored, v[33], string.concat(tag, " poolRestored"));
        assertEq(r.seniorRestored, v[34], string.concat(tag, " seniorRestored"));
        assertEq(r.juniorGain, v[35], string.concat(tag, " juniorGain"));
        assertEq(r.backstopRepaid, v[36], string.concat(tag, " backstopRepaid"));
        assertEq(r.backstopCovered, v[37], string.concat(tag, " backstopCovered"));
        assertEq(s.seniorIfDeferred, v[39], string.concat(tag, " seniorIfDeferred'"));
        assertEq(r.seniorIfCharged, v[40], string.concat(tag, " seniorIfCharged"));
        assertLe(s.seniorIfDeferred, s.poolDebt - s.poolValue, string.concat(tag, " deferred <= shortfall"));
        // the ledger's invariants hold after every mark
        assertLe(s.seniorIfImpairment, s.seniorImpairment, string.concat(tag, " impIf <= imp"));
        assertLe(s.coverHeld, s.seniorNav, string.concat(tag, " cover <= S"));
        assertLe(s.coverHeld, s.backstopDebt, string.concat(tag, " cover <= backstopDebt"));
        assertLe(s.poolValue, s.poolDebt, string.concat(tag, " claim <= debt"));
        assertLe(r.backstopCovered, v[2] + r.seniorLoss - v[3] - (r.seniorIfLoss - r.seniorIfCharged), string.concat(tag, " cover off the IF"));
    }

    function test_parity_poolWindow() public view {
        for (uint256 i = 0; i < count; i++) {
            uint256[] memory v = _row("poolWindow", i);
            assertEq(v.length, 15, "poolWindow row width");
            string memory tag = string.concat("poolWindow[", vm.toString(i), "]");
            uint256 raised = Waterfall.windowIfTarget(v[0], true);
            assertEq(raised, 0, string.concat(tag, " nothing raised for the IF"));
            Waterfall.WindowResult memory r = Waterfall.allocateWindow(
                Waterfall.WindowInput({
                    ifTargetUsd: raised,
                    mmInventoryUsd: v[1],
                    seniorCapBps: v[2],
                    seniorCommitted: v[3],
                    juniorCommitted: v[4],
                    sponsorJuniorCommitted: v[5]
                })
            );
            assertEq(r.ok ? 1 : 0, v[6], string.concat(tag, " ok"));
            assertEq(uint256(r.reason), v[7], string.concat(tag, " reason"));
            assertTrue(r.reason != Waterfall.REASON_IF_UNFUNDED, string.concat(tag, " never IF_UNFUNDED"));
            assertEq(r.seniorAllocated, v[8], string.concat(tag, " seniorAllocated"));
            assertEq(r.juniorAllocated, v[9], string.concat(tag, " juniorAllocated"));
            (uint256 ifAmount, uint256 mmAmount, uint256 idle) =
                Waterfall.initialDeployment(r.seniorAllocated + r.juniorAllocated, raised, v[1]);
            assertEq(ifAmount, v[10], string.concat(tag, " ifRaised"));
            assertEq(mmAmount, v[11], string.concat(tag, " mmAmount"));
            assertEq(idle, v[12], string.concat(tag, " idle"));
            bool capitalOk = Waterfall.poolCapitalOk(r.seniorAllocated + r.juniorAllocated, v[0], v[13]);
            assertEq(capitalOk ? 1 : 0, v[14], string.concat(tag, " capitalOk"));
        }
    }
}
