# Robinhood Chain MAINNET build: `bun run build:mainnet` (vite --mode mainnet; update.sh on the mainnet host).
# Non-secret public endpoints only. The API must run against the same chain (CHAIN_ID=4663).
VITE_CHAIN_ID=4663
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_EXPLORER_URL=https://explorer.chain.robinhood.com
VITE_API_URL=http://127.0.0.1:4400
