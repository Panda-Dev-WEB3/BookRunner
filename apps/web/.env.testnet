# Robinhood Chain testnet build: `bun run dev:testnet` / `bun run build:testnet` (vite --mode testnet).
# Non-secret public endpoints only. The API must run against the same chain (CHAIN_ID=46630).
VITE_CHAIN_ID=46630
VITE_RPC_URL=https://rpc.testnet.chain.robinhood.com
VITE_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
VITE_FAUCET_URL=https://faucet.testnet.chain.robinhood.com
VITE_API_URL=http://127.0.0.1:4400
