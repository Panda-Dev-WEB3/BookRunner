# apps/web runtime configuration (copy to .env.local to override; all optional).
# Defaults target the local devnet: chain 31337, RPC http://127.0.0.1:8547, API http://127.0.0.1:4400.

# Chain this build runs on. 31337 = devnet (dev-wallet picker enabled), 46630 = Robinhood Chain testnet.
VITE_CHAIN_ID=31337
# JSON-RPC for reads, the injected wallet's transport and the "add network" helper.
VITE_RPC_URL=http://127.0.0.1:8547
# Block explorer base (tx / address links). Empty on devnet.
VITE_EXPLORER_URL=
# Faucet for testnet gas (shown when the connected address has no native balance).
VITE_FAUCET_URL=
# Bookrunner API (tRPC at /trpc, health at /health).
VITE_API_URL=http://127.0.0.1:4400
# Optional display name for a custom chain id.
VITE_CHAIN_NAME=
# Optional kind of a custom chain id: devnet, testnet or mainnet. A custom chain id is treated like
# mainnet (no test-USDC mint, no "no value" copy) unless this says devnet or testnet.
VITE_CHAIN_KIND=
# Optional USDC address (otherwise read from a book's Senior tranche asset()).
VITE_USDC_ADDRESS=
# Optional WalletConnect Cloud project id (https://cloud.reown.com). When set, the connect dialog also
# offers WalletConnect (QR code / mobile wallets); when empty that option is hidden. Public value.
VITE_WALLETCONNECT_PROJECT_ID=
